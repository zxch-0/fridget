{
  "name": "fridget",
  "version": "1.0.0",
  "private": true,
  "description": "Fridget — trouvez les meilleurs prix et comparez vos tickets de caisse entre enseignes.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"PORT=8787 node server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
